    "blocks": [
      "FREE_ATOM4_HAL"
    ],
    "rule": "median of the PRESENT subset of that fold's training portion (screen_inner_train + screen_inner_val), applied to both the training and held-out portions of that fold",
    "why_not_baked_into_the_csv": "a whole-population median would put held-out information into every fold's fit",
