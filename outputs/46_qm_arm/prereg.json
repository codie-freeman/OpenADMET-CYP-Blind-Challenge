      "has_Cl",
      "has_F"
    ],
    "coverage_train": {
      "Cl": 584,
      "F": 1157
    }
  },
  "statistical_route": {
    "name": "Ash et al. 2025 parametric default, main text Section 3.2.2",
    "steps": [
      "repeated-measures ANOVA per metric",
      "Bonferroni the ANOVA alpha by the number of metrics",
      "Tukey HSD post-hoc only where the ANOVA clears",
      "compact letter display from the Tukey pairwise matrix"
    ],
    "alpha": 0.05,
    "n_metrics": 2,
    "alpha_adjusted": 0.025,
    "n_methods": 6,
    "expected_posthoc": "tukey",
    "why_not_BH": "BH is Ash's exception above 10 methods and its justification lives in SI Section A.2, which is not available in this project. The family is held at 6 so the verifiable parametric route applies, and so Tukey's confidence intervals -- which the materiality bars need -- exist.",
    "branch_rule": "measured per (isoform, metric): parametric iff Levene p > 0.05 AND max/min variance ratio <= 9. If a cell routes nonparametric, Conover-Friedman + Holm gives no CI, and the paired-t CI is reported beside it as an effect-size estimate, not as the test.",
    "no_correction_stacked_on_tukey": "Tukey controls FWER within each (isoform, metric) family by construction"
  },
  "co_primary_metrics": [
    "ST-RAE",
    "Spearman_R"
  ],
  "materiality_bars": {
    "ST-RAE": {
      "CYP1A2": 0.0234,
      "CYP2C9": 0.0209,
      "CYP2D6": 0.0277,
      "CYP3A4": 0.016
    },
    "Spearman_R": {
      "CYP1A2": 0.0183,
      "CYP2C9": 0.016,
      "CYP2D6": 0.0212,
      "CYP3A4": 0.01
    },
    "construction": "2 x the mean paired SE against `plain`, pooled across notebook 37's ten arms, from the 34+35+37 run_scores pool"
  },
  "tier1": {
    "purpose": "choose M*, no p-values presented as evidence",
    "partition": "data/folds/cv_folds.csv, repeat_0, fold 0 -- the RANDOM partition, so the frozen 25-fold stays unseen until the formal tier",
    "grid": "6 blocks x 4 models x 3 seeds",
    "selection_rule": "lowest mean macro ST-RAE on the FREE baseline block ALONE, so the model cannot be selected for liking the QM blocks"
