# stay tracked -- small, and what this notebook reports from.
outputs/18_charge_augmented_chemprop_screen/chemprop_runs/
outputs/18_charge_augmented_chemprop_screen/predictions/
outputs/18_charge_augmented_chemprop_screen/scores/

